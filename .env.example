# Lead form — set ONE destination. Used in src/lib/deliver-lead.ts
# (submitLead server action + POST /api/lead). See DEPLOY.md.

# Option A — Formspree (https://formspree.io)
# Example: if the endpoint is https://formspree.io/f/abcdxyz, the value is abcdxyz
FORMSPREE_FORM_ID=

# Option B — webhook (Zapier, Make, custom)
# Example: https://hooks.example.com/tiny-cabin-leads
LEAD_WEBHOOK_URL=
# Optional. Sent as: Authorization: Bearer <value>
LEAD_WEBHOOK_SECRET=

# Option C — Resend (https://resend.com)
# Example key shape: re_xxxxxxxx  |  Example inbox: josh@example.com
RESEND_API_KEY=
LEAD_TO_EMAIL=
# Optional. Example: Tiny Cabin <hello@tinycabin.com>
# Unset → Tiny Cabin <onboarding@resend.dev> (Resend test sender)
LEAD_FROM_EMAIL=

# Affiliate / partner tracking URLs (optional). Empty or "#" hides the card.
# Set on Netlify, then rebuild — these are read at build time on static pages.
# AFFILIATE_TEXAS_TINY_HOMES=
# Example (do not commit in source): https://getdpd.com/cart/hoplink/25865?referrer=2e11gva9x7dws884
# AFFILIATE_TINY_HOME_BUILDERS=
# Example (do not commit in source): https://getdpd.com/cart/hoplink/18727?referrer=2e11gva9x7dws884
# AFFILIATE_JAMAICA_COTTAGE_SHOP=
# AFFILIATE_COMPO_CLOSET=
# Any non-empty value shows the Amazon Associates footer line (only if used):
# AFFILIATE_AMAZON_ASSOCIATES=
