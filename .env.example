# Lead form destination — set ONE of the three options below.
# Do not commit real secrets. Copy this file to .env.local for local testing.

# Option A — Formspree (fastest soft launch)
# 1. Create a form at https://formspree.io
# 2. Paste the form id from the endpoint https://formspree.io/f/<id>
FORMSPREE_FORM_ID=

# Option B — generic webhook (Zapier, Make, a custom inbox, etc.)
# POST JSON to this URL on each valid submit.
LEAD_WEBHOOK_URL=
# Optional bearer token sent as: Authorization: Bearer <secret>
LEAD_WEBHOOK_SECRET=

# Option C — Resend email
# 1. Create an API key at https://resend.com
# 2. Verify a from-domain, or use Resend's onboarding sender for tests
RESEND_API_KEY=
LEAD_TO_EMAIL=
# Defaults to: Tiny Cabin <onboarding@resend.dev>
LEAD_FROM_EMAIL=
